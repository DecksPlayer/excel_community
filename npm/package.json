{
  "name": "excel-community",
  "version": "2.5.3",
  "description": "High-performance Excel XLSX library for Node.js and Browser compiled directly from Dart excel_community.",
  "main": "./index.js",
  "module": "./dist/excel_community.mjs",
  "types": "./index.d.ts",
  "browser": {
    "fs": false
  },
  "unpkg": "./dist/excel_community.browser.js",
  "jsdelivr": "./dist/excel_community.browser.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./index.d.mts",
        "default": "./dist/excel_community.mjs"
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./browser": "./dist/excel_community.browser.js"
  },
  "files": [
    "dist/",
    "index.js",
    "index.mjs",
    "wrapper.js",
    "index.d.ts",
    "index.d.mts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "node build.js",
    "test": "node test.js && node test-features.js",
    "example": "node example/serve.js"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "workbook",
    "charts",
    "tables",
    "formulas",
    "node",
    "browser"
  ],
  "author": "DecksPlayer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decksplayer/excel_community.git"
  },
  "engines": {
    "node": ">=18"
  }
}